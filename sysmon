def rgb256(r, g, b):
    """Nearest xterm-256 colour index (6x6x6 cube or the grey ramp)."""
    def q(v):
        return 0 if v < 48 else (1 if v < 115 else (v - 35) // 40)
    levels = (0, 95, 135, 175, 215, 255)
    qr, qg, qb = q(r), q(g), q(b)
    cr, cg, cb = levels[qr], levels[qg], levels[qb]
    cube = 16 + 36 * qr + 6 * qg + qb
    avg = (r + g + b) // 3
    gi = 23 if avg > 238 else max(0, (avg - 3) // 10)
    gv = 8 + 10 * gi
    dc = (cr - r) ** 2 + (cg - g) ** 2 + (cb - b) ** 2
    dg = (gv - r) ** 2 + (gv - g) ** 2 + (gv - b) ** 2
    return 232 + gi if dg < dc else cube


class Palette(object):
    """Turns colour tuples into escape codes for the terminal's colour depth."""

    def __init__(self, mode):
        self.mode = mode  # "truecolor" | "256" | "16" | "none"
        self.on = mode != "none"
        self.track = mode in ("truecolor", "256")
        self.bold = "\x1b[1m" if self.on else ""
        self.rev = "\x1b[7m" if self.on else ""
        self.reset = RESET if self.on else ""
        self._cache = {}

    def fg(self, c):
        return self._esc(c, 38)

    def bg(self, c):
        return self._esc(c, 48)

    def _esc(self, c, base):
        key = (c, base)
        code = self._cache.get(key)
        if code is None:
            code = self._cache[key] = self._make(c, base)
        return code

    def _make(self, c, base):
        if not self.on or c is None:
            return ""
        r, g, b, i16 = c
        if self.mode == "truecolor":
            return "\x1b[%d;2;%d;%d;%dm" % (base, r, g, b)
        if self.mode == "256":
            return "\x1b[%d;5;%dm" % (base, rgb256(r, g, b))
        off = base - 8  # 30 for foreground, 40 for background
        return "\x1b[%dm" % (off + i16 if i16 < 8 else off + 60 + i16 - 8)

    def paint(self, text, fg=None, bg=None, bold=False):
        if not self.on or not text:
            return text
        pre = (self.bold if bold else "") + self.fg(fg) + self.bg(bg)
        return pre + text + RESET if pre else text


