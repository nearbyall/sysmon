def bar(width, segs):
    """Horizontal meter with sub-cell precision.

    segs is a list of (fraction, colour); colour None paints the cells with the
    heat gradient by position, so a fuller bar reaches into the red.
    """
    if width <= 0:
        return ""
    hb = G["hb"]
    steps = len(hb) - 1
    full = width * steps
    ends, acc = [], 0.0
    for frac, col in segs:
        acc += max(0.0, frac or 0.0)
        ends.append((min(acc, 1.0) * full, col))
    filled = int(ends[-1][0] + 0.5) if ends else 0
    track = P.track and steps > 1
    parts, cur = [], ""
    for i in range(width):
        lo = i * steps
        n = min(steps, max(0, filled - lo))
        if n == 0:
            style = P.bg(C_TRACK) if track else P.fg(C_DIM)
            ch = " " if track else G["empty"]
        else:
            mid = lo + n / 2.0
            col = ends[-1][1]
            for end, c in ends:
                if mid < end:
                    col = c
                    break
            if col is None:
                col = grad(i / (width - 1.0) if width > 1 else 1.0)
            style = P.fg(col)
            if n < steps and track:
                style += P.bg(C_TRACK)
            ch = hb[n]
        if style != cur:
            parts.append(P.reset if cur else "")
            parts.append(style)
            cur = style
        parts.append(ch)
    if cur:
        parts.append(P.reset)
    return "".join(parts)


def graph(values, width, height, stops=HEAT, vmax=100.0, down=False):
    """Column chart of the newest `width` samples, `height` rows tall.

    Each cell is coloured by its own height, so tall graphs get a vertical
    gradient. down=True hangs the columns from the top (mirrored graphs).
    """
    if width <= 0 or height <= 0:
        return []
    vb = G["vb"]
    steps = len(vb) - 1
    full = height * steps
    vals = list(values)[-width:]
    units = []
    for v in vals:
        u = int(v / vmax * full + 0.5) if vmax > 0 else 0
        if u <= 0 and v > 0:
            u = 1  # keep any activity visible
        units.append(min(max(u, 0), full))
    pad = " " * (width - len(units))
    invert = down and G["inv"] and P.on
    out = []
    for row in range(height):
        level = row if down else height - 1 - row
        base = level * steps
        parts, cur = [pad], ""
        for u in units:
            n = u - base
            if n <= 0:
                style, ch = "", " "
            else:
                n = min(n, steps)
                style = P.fg(grad((base + n) / float(full), stops))
                if n == steps:
                    ch = vb[steps]
                elif invert:
                    style, ch = style + P.rev, vb[steps - n]
                else:
                    ch = vb[n]
            if style != cur:
                parts.append(P.reset if cur else "")
                parts.append(style)
                cur = style
            parts.append(ch)
        if cur:
            parts.append(P.reset)
        out.append("".join(parts))
    return out


def border_line(width, corners, left="", right=""):
    """A box edge with optional styled captions on both sides."""
    a, b = corners
    h = G["h"]
    if width < 4:
        return P.paint(h * max(0, width), C_BORDER)
    bc = P.fg(C_BORDER)
    avail = width - 4
    lw = vwidth(left) if left else 0
    rw = vwidth(right) if right else 0
    if rw and (lw + 3 if lw else 0) + rw + 2 > avail:
        right, rw = "", 0
    if lw and lw + 2 > avail:
        left = vslice(left, 0, max(0, avail - 2))
        lw = vwidth(left)
    fill = avail - (lw + 2 if lw else 0) - (rw + 2 if rw else 0)
    out = bc + a + h + P.reset
    if lw:
        out += " " + left + " "
    out += bc + h * fill + P.reset
    if rw:
        out += " " + right + " "
    return out + bc + h + b + P.reset


class Panel(object):
    """A bordered box whose content is a stack of blocks.

    Fixed blocks always show; flexible blocks (graphs, long lists) soak up
    whatever height the layout hands out, in priority order.
    """

    def __init__(self, width, title, accent, sub="", right="", foot="", foot_right=""):
        self.w = width
        self.iw = width - 4
        self.title, self.accent, self.sub, self.right = title, accent, sub, right
        self.foot, self.foot_right = foot, foot_right
        self.blocks = []  # [min, max, priority, lines or callable(n) -> lines]

    def add(self, lines):
        self.blocks.append([len(lines), len(lines), 0, lines])

    def flex(self, fn, lo=0, hi=999, prio=1):
        self.blocks.append([lo, max(lo, hi), prio, fn])

    def min_height(self):
        return 2 + sum(b[0] for b in self.blocks)

    def max_height(self):
        return 2 + sum(b[1] for b in self.blocks)

    def top(self):
        t = P.paint(self.title, self.accent, bold=True)
        rw = vwidth(self.right) if self.right else 0
        room = self.w - 4 - (len(self.title) + 2) - (rw + 3 if rw else 0) - 1
        if self.sub and room >= 4:
            t += " " + P.paint(clip(sanitize(self.sub), room), C_DIM)
        return border_line(self.w, (G["tl"], G["tr"]), t, self.right)

    def render(self, height):
        extra = height - self.min_height()
        alloc = [b[0] for b in self.blocks]
        for i in sorted(range(len(self.blocks)), key=lambda i: self.blocks[i][2]):
            b = self.blocks[i]
            if extra > 0 and callable(b[3]):
                add = min(extra, b[1] - b[0])
                alloc[i] += add
                extra -= add
        content = []
        for b, n in zip(self.blocks, alloc):
            if n > 0:
                content.extend(b[3](n) if callable(b[3]) else b[3])
        v = P.paint(G["v"], C_BORDER)
        lines = [self.top()]
        for i in range(max(0, height - 2)):
            c = content[i] if i < len(content) else ""
            lines.append(v + " " + vfit(c, self.iw) + " " + v)
        lines.append(border_line(self.w, (G["bl"], G["br"]), self.foot, self.foot_right))
        return lines[:height]


