def fmt_bytes(n):
    """Human size, at most 5 cells: 512B 9.8G 15.6G 120G."""
    if n is None:
        return "-"
    n = float(n)
    unit = "B"
    for unit in "BKMGTPE":
        if abs(n) < 1000 or unit == "E":
            break
        n /= 1024.0
    if unit == "B":
        return "%dB" % n
    if abs(n) < 99.95:
        return "%.1f%s" % (n, unit)
    return "%.0f%s" % (n, unit)


def fmt_rate(n):
    return "-" if n is None else fmt_bytes(n) + "/s"


def fmt_duration(sec):
    sec = int(sec)
    d, sec = divmod(sec, 86400)
    h, sec = divmod(sec, 3600)
    m = sec // 60
    if d:
        return "%dd %dh %02dm" % (d, h, m)
    if h:
        return "%dh %02dm" % (h, m)
    return "%dm" % m


def fmt_cputime(ticks):
    """CPU time like top's TIME+: 3:07.45, 12h03:21, 1234h."""
    hs = ticks * 100 // CLK_TCK
    s, hs = divmod(hs, 100)
    m, s = divmod(s, 60)
    h, m = divmod(m, 60)
    if h == 0:
        return "%d:%02d.%02d" % (m, s, hs)
    if h < 100:
        return "%dh%02d:%02d" % (h, m, s)
    return "%dh" % h


# --------------------------------------------------------------------------
# Reading /proc and /sys
# --------------------------------------------------------------------------

def read_text(path, default=None):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except (OSError, ValueError):
        return default


def read_int(path, default=None):
    try:
        with open(path, "rb") as f:
            return int(f.read().split()[0])
    except (OSError, ValueError, IndexError):
        return default


def os_name():
    for path in ("/etc/os-release", "/usr/lib/os-release"):
        text = read_text(path)
        if not text:
            continue
        vals = {}
        for line in text.splitlines():
            k, sep, v = line.partition("=")
            if sep:
                vals[k.strip()] = v.strip().strip("\"'")
        name = vals.get("PRETTY_NAME") or vals.get("NAME")
        if name:
            return name
    return "Linux"


def cpu_model():
    model = None
    for line in read_text("/proc/cpuinfo", "").splitlines():
        k, sep, v = line.partition(":")
        k, v = k.strip(), v.strip()
        if v and k in ("model name", "Model", "Hardware", "cpu model"):
            model = v
            if k == "model name":
                break
    if not model:
        model = (read_text("/proc/device-tree/model") or "").strip("\0 \n")
    model = model or os.uname().machine
    model = re.sub(r"\((R|r|TM|tm)\)", "", model)
    model = re.sub(r"\s*@.*$", "", model)
    model = re.sub(r"\s+with\s+.*$", "", model)
    model = re.sub(r"\b(CPU|Processor)\b", "", model)
    return " ".join(model.split())


def read_proc_stat():
    """Per-CPU jiffies (user nice system idle iowait irq softirq steal)."""
    cpus, ctxt = {}, 0
    with open("/proc/stat") as f:
        for line in f:
            if line.startswith("cpu"):
                parts = line.split()
                vals = [int(x) for x in parts[1:9]]
                vals += [0] * (8 - len(vals))
                cpus[parts[0]] = vals
            elif line.startswith("ctxt "):
                ctxt = int(line.split()[1])
    return cpus, ctxt


def cpu_usage(prev, cur):
    if prev is None or cur is None:
        return None
    d = [max(0, c - p) for c, p in zip(cur, prev)]
    total = float(sum(d))
    if total <= 0:
        return None
    user, nice, system, idle, iowait, irq, softirq, steal = d
    return dict(busy=(total - idle - iowait) / total * 100,
                usr=(user + nice) / total * 100, sys=system / total * 100,
                wait=iowait / total * 100, irq=(irq + softirq) / total * 100,
                steal=steal / total * 100)


_freq_paths = None


def read_freq():
    """Average current CPU clock in MHz, or None."""
    global _freq_paths
    if _freq_paths is None:
        _freq_paths = glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq")
    vals = [v for v in (read_int(p) for p in _freq_paths) if v]
    if vals:
        return sum(vals) / len(vals) / 1000.0
    mhz = []
    for line in read_text("/proc/cpuinfo", "").splitlines():
        if line.startswith("cpu MHz"):
            try:
                mhz.append(float(line.split(":")[1]))
            except (IndexError, ValueError):
                pass
    return sum(mhz) / len(mhz) if mhz else None


def read_meminfo():
    m = {}
    for line in read_text("/proc/meminfo", "").splitlines():
        k, _, v = line.partition(":")
        parts = v.split()
        if parts:
            try:
                m[k] = int(parts[0]) * (1024 if len(parts) > 1 else 1)
            except ValueError:
                pass
    return m


def read_psi():
    """10s average of the 'some' pressure line for cpu/memory/io."""
    out = {}
    for res in ("cpu", "memory", "io"):
        text = read_text("/proc/pressure/" + res)
        for line in (text or "").splitlines():
            if line.startswith("some"):
                for tok in line.split():
                    if tok.startswith("avg10="):
                        try:
                            out[res] = float(tok[6:])
                        except ValueError:
                            pass
    return out


def read_battery():
    for ps in sorted(glob.glob("/sys/class/power_supply/*")):
        if (read_text(ps + "/type") or "").strip() != "Battery":
            continue
        if (read_text(ps + "/scope") or "").strip() == "Device":
            continue  # a mouse or a headset, not the laptop battery
        cap = read_int(ps + "/capacity")
        if cap is not None:
            return cap, (read_text(ps + "/status") or "").strip()
    return None


def logged_in_users():
    """Number of login sessions, like uptime(1); None if utmp is unavailable."""
    try:
        with open("/var/run/utmp", "rb") as f:
            data = f.read()
    except OSError:
        return None
    n = 0
    for off in range(0, len(data) - 383, 384):  # glibc struct utmp
        ut_type, pid = struct.unpack_from("hxxi", data, off)
        if ut_type == 7 and data[off + 44] and os.path.exists("/proc/%d" % pid):
            n += 1
    return n


def read_net_dev():
    out = {}
    for line in read_text("/proc/net/dev", "").splitlines()[2:]:
        name, sep, rest = line.partition(":")
        f = rest.split()
        if sep and len(f) >= 9:
            out[name.strip()] = (int(f[0]), int(f[8]))
    return out


def ipv4_addr(ifname):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            req = struct.pack("256s", ifname[:15].encode())
            res = fcntl.ioctl(s.fileno(), 0x8915, req)  # SIOCGIFADDR
            return socket.inet_ntoa(res[20:24])
        finally:
            s.close()
    except (OSError, ValueError):
        return None


def block_devices():
    """Whole disks worth showing I/O for (no loop/ram/optical/dm duplicates)."""
    skip = ("loop", "ram", "zram", "sr", "fd", "dm-", "nbd", "mtdblock")
    try:
        names = sorted(os.listdir("/sys/block"))
    except OSError:
        return []
    return [n for n in names if not n.startswith(skip)
            and read_int("/sys/block/%s/size" % n, 0) > 0]


def read_diskstats(names):
    out = {}
    for line in read_text("/proc/diskstats", "").splitlines():
        f = line.split()
        if len(f) >= 14 and f[2] in names:
            # bytes read, bytes written (sectors are always 512 B), ms busy
            out[f[2]] = (int(f[5]) * 512, int(f[9]) * 512, int(f[12]))
    return out


class Sensors(object):
    """Temperatures from hwmon (or thermal zones as a fallback)."""

    CPU_CHIPS = {"coretemp": 3, "k10temp": 3, "zenpower": 3, "x86_pkg_temp": 3,
                 "cpu_thermal": 2, "cpu-thermal": 2, "soc_thermal": 2, "acpitz": 1}
    NICE = (("nvme", "nvme"), ("amdgpu", "gpu"), ("nouveau", "gpu"), ("radeon", "gpu"),
            ("i915", "gpu"), ("iwlwifi", "wifi"), ("ath", "wifi"), ("mt7", "wifi"),
            ("pch_", "pch"), ("spd5118", "ram"), ("jc42", "ram"), ("nct", "board"),
            ("it8", "board"), ("thinkpad", "ec"), ("dell_smm", "ec"))

    def __init__(self):
        self.inputs = []
        for hw in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
            chip = (read_text(hw + "/name") or "").strip()
            if not chip or chip == "drivetemp":  # would wake sleeping disks
                continue
            for path in sorted(glob.glob(hw + "/temp*_input")):
                label = (read_text(path[:-6] + "_label") or "").strip()
                self.inputs.append((chip, label, path))
        if not self.inputs:
            for tz in sorted(glob.glob("/sys/class/thermal/thermal_zone*")):
                kind = (read_text(tz + "/type") or "").strip()
                if kind:
                    self.inputs.append((kind, "", tz + "/temp"))

    def nice(self, chip):
        for prefix, name in self.NICE:
            if chip.startswith(prefix):
                return name
        return chip[:8]

    def read(self):
        """-> (cpu temperature or None, [(name, temperature)] of the rest)"""
        best = None
        others = collections.OrderedDict()
        for chip, label, path in self.inputs:
            v = read_int(path)
            if v is None:
                continue
            t = v / 1000.0
            if not -30 < t < 150:
                continue
            score = self.CPU_CHIPS.get(chip)
            if score is not None:
                if label.startswith(("Package", "Tctl", "Tdie")):
                    score += 1
                if best is None or (score, t) > best:
                    best = (score, t)
            else:
                name = self.nice(chip)
                others[name] = max(others.get(name, t), t)
        return (best[1] if best else None), list(others.items())


