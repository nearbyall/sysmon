_grad_cache = {}


def grad(frac, stops=HEAT):
    """Colour at position frac (0..1) of a gradient."""
    if frac != frac or frac < 0:  # NaN or negative
        frac = 0.0
    elif frac > 1:
        frac = 1.0
    key = (id(stops), int(frac * 64 + 0.5))
    c = _grad_cache.get(key)
    if c is None:
        f = key[1] / 64.0
        lo = hi = stops[0]
        for hi in stops[1:]:
            if f <= hi[0]:
                break
            lo = hi
        span = hi[0] - lo[0]
        t = (f - lo[0]) / span if span > 0 else 0.0
        rgb = tuple(int(a + (b - a) * t + 0.5) for a, b in zip(lo[1], hi[1]))
        c = _grad_cache[key] = rgb + (lo[2],)
    return c


# --------------------------------------------------------------------------
# Text helpers (display width aware, ANSI aware)
# --------------------------------------------------------------------------

_ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
_ANSI_SPLIT = re.compile(r"(\x1b\[[0-9;?]*[ -/]*[@-~])")
_CTRL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def sanitize(s):
    """Make untrusted text (process names, paths) safe to print."""
    s = _CTRL_RE.sub(" ", s)
    if G is GLYPHS["ascii"]:
        s = s.encode("ascii", "replace").decode("ascii")
    return s


def char_width(ch):
    if ch < "̀":
        return 1
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def text_width(s):
    if not s or max(s) < "̀":
        return len(s)
    return sum(char_width(ch) for ch in s)


def clip(s, width, ell=True):
    """Cut plain text to `width` cells, marking the cut with an ellipsis."""
    if width <= 0:
        return ""
    if text_width(s) <= width:
        return s
    limit = width - 1 if ell else width
    out, w = [], 0
    for ch in s:
        cw = char_width(ch)
        if w + cw > limit:
            break
        out.append(ch)
        w += cw
    return "".join(out) + (G["ell"] if ell else "")


def clip_left(s, width):
    """Like clip() but keeps the tail: '…/long/mount/point'."""
    if width <= 0:
        return ""
    if text_width(s) <= width:
        return s
    out, w = [], 0
    for ch in reversed(s):
        cw = char_width(ch)
        if w + cw > width - 1:
            break
        out.append(ch)
        w += cw
    return G["ell"] + "".join(reversed(out))


def fit(s, width, align="<"):
    """Clip and pad plain text to exactly `width` cells."""
    s = clip(s, width)
    gap = width - text_width(s)
    if gap <= 0:
        return s
    if align == ">":
        return " " * gap + s
    if align == "^":
        return " " * (gap // 2) + s + " " * (gap - gap // 2)
    return s + " " * gap


def vwidth(s):
    return text_width(_ANSI_RE.sub("", s))


def vslice(s, start, end):
    """Cells [start, end) of a styled string; styles before `start` are kept."""
    out, w = [], 0
    for part in _ANSI_SPLIT.split(s):
        if not part:
            continue
        if part[0] == "\x1b":
            out.append(part)
            continue
        for ch in part:
            if w >= end:
                break
            cw = char_width(ch)
            if w >= start and w + cw <= end:
                out.append(ch)
            elif w < start < w + cw or w < end < w + cw:
                out.append(" ")  # half of a wide character
            w += cw
    if w < end:
        out.append(" " * (end - max(w, start)))
    return "".join(out) + P.reset


def vfit(s, width):
    """Pad or clip a styled string to exactly `width` cells."""
    w = vwidth(s)
    if w == width:
        return s
    if w < width:
        return s + " " * (width - w)
    return vslice(s, 0, width)


def sep_join(parts):
    sep = " " + P.paint(G["dot"], C_DIM) + " "
    return sep.join(p for p in parts if p)


