#!/bin/sh
# -*- coding: utf-8 -*-
# This file is both a shell script and a Python program: sh runs the lines up
# to the closing quotes and re-executes the file with Python, which in turn
# treats them as a harmless string. So `./sysmon` and `sh sysmon` both work.
''':'
for py in python3 /usr/libexec/platform-python python; do
    if command -v "$py" >/dev/null 2>&1 &&
       "$py" -c 'import sys; sys.exit(sys.version_info < (3, 6))' 2>/dev/null; then
        exec "$py" "$0" "$@"
    fi
done
echo "sysmon: needs Python 3.6+ (it is preinstalled on most distros)." >&2
echo "  Debian/Ubuntu: sudo apt install python3" >&2
echo "  Fedora/RHEL:   sudo dnf install python3" >&2
echo "  Alpine:        sudo apk add python3" >&2
exit 1
'''

"""sysmon - a pretty, zero-dependency live system monitor for the Linux console.

One file, Python 3.6+ standard library only. Everything is read straight from
/proc and /sys, so it runs as-is on any Linux box, over SSH or on a bare tty.

    sysmon              live dashboard (q quits, ? shows the keys)
    sysmon --once       print a single snapshot and exit
"""

