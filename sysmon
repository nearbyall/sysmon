# Terminal handling and the main loop
# --------------------------------------------------------------------------

KEYS = {
    b"\x1b[A": "UP", b"\x1b[B": "DOWN", b"\x1b[C": "RIGHT", b"\x1b[D": "LEFT",
    b"\x1bOA": "UP", b"\x1bOB": "DOWN", b"\x1bOC": "RIGHT", b"\x1bOD": "LEFT",
    b"\x1b[5~": "PGUP", b"\x1b[6~": "PGDN",
    b"\x1b[H": "HOME", b"\x1b[F": "END", b"\x1bOH": "HOME", b"\x1bOF": "END",
    b"\x1b[1~": "HOME", b"\x1b[4~": "END", b"\x1b[7~": "HOME", b"\x1b[8~": "END",
    b"\x1bOP": "F1", b"\x1b[11~": "F1", b"\x1b[[A": "F1",
}
_KEYS_SORTED = sorted(KEYS.items(), key=lambda kv: -len(kv[0]))


def parse_keys(data):
    keys, i = [], 0
    while i < len(data):
        if data[i] == 0x1b:
            for seq, name in _KEYS_SORTED:
                if data.startswith(seq, i):
                    keys.append(name)
                    i += len(seq)
                    break
            else:
                if i + 1 < len(data) and data[i + 1] in b"[O":
                    j = i + 2  # skip an unknown CSI / SS3 sequence
                    while j < len(data) and not 0x40 <= data[j] <= 0x7e:
                        j += 1
                    i = j + 1
                else:
                    keys.append("ESC")
                    i += 1
        else:
            b = data[i]
            n = 1 if b < 0xc0 else (2 if b < 0xe0 else (3 if b < 0xf0 else 4))
            keys.append(data[i:i + n].decode("utf-8", "replace"))
            i += n
    return keys


class Terminal(object):
    def __init__(self):
        self.ifd = sys.stdin.fileno()
        self.ofd = sys.stdout.fileno()
        self.saved = None
        self.prev = []
        self.sync = os.environ.get("TERM", "") != "linux"
        self.wake_r, self.wake_w = os.pipe()
        for fd in (self.wake_r, self.wake_w):
            fl = fcntl.fcntl(fd, fcntl.F_GETFL)
            fcntl.fcntl(fd, fcntl.F_SETFL, fl | os.O_NONBLOCK)

    def enter(self):
        self.saved = termios.tcgetattr(self.ifd)
        mode = termios.tcgetattr(self.ifd)
        mode[3] &= ~(termios.ICANON | termios.ECHO)
        mode[6][termios.VMIN] = 1
        mode[6][termios.VTIME] = 0
        termios.tcsetattr(self.ifd, termios.TCSANOW, mode)
        # alternate screen, hide cursor, no autowrap, clear
        self.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[2J")
        self.prev = []

    def leave(self):
        try:
            self.write("\x1b[0m\x1b[?7h\x1b[?25h\x1b[?1049l")
        except OSError:
            pass
        if self.saved is not None:
            try:
                termios.tcsetattr(self.ifd, termios.TCSADRAIN, self.saved)
            except termios.error:
                pass

    def write(self, s):
        data = s.encode("utf-8", "replace")
        while data:
            n = os.write(self.ofd, data)
            data = data[n:]

    def size(self):
        try:
            sz = os.get_terminal_size(self.ofd)
            return sz.columns, sz.lines
        except OSError:
            return 80, 24

    def draw(self, lines):
        """Repaint only the rows that changed since the previous frame."""
        out = ["\x1b[?2026h"] if self.sync else []
        for i, line in enumerate(lines):
            if i < len(self.prev) and self.prev[i] == line:
                continue
            out.append("\x1b[%d;1H%s\x1b[0m" % (i + 1, line))
        if self.sync:
            out.append("\x1b[?2026l")
        self.prev = lines
        self.write("".join(out))

    def events(self, timeout):
        try:
            ready = select.select([self.ifd, self.wake_r], [], [], timeout)[0]
        except (OSError, select.error):
            return []
        evs = []
        if self.wake_r in ready:
            try:
                for b in os.read(self.wake_r, 256):
                    evs.append({signal.SIGWINCH: "RESIZE", signal.SIGTSTP: "SUSPEND"}.get(b))
            except OSError:
                pass
        if self.ifd in ready:
            data = os.read(self.ifd, 1024)
            if not data:
                return ["QUIT"]  # the terminal went away
            evs.extend(parse_keys(data))
        return [e for e in evs if e]


class UI(object):
    SORT_KEYS = {"c": "cpu", "m": "mem", "p": "pid", "t": "time", "n": "name"}
    INTERVALS = (0.25, 0.5, 1.0, 1.5, 2.0, 3.0, 5.0, 10.0)

    def __init__(self, interval=1.0, sort="cpu"):
        self.interval = interval
        self.sort = sort
        self.reverse = False
        self.filter = ""
        self.editing = False
        self.kthreads = False
        self.scroll = 0
        self.page = 10
        self.paused = False
        self.help = False

    def handle(self, key):
        """Apply a key press; returns "quit", "redraw", "interval" or None."""
        if self.editing:
            if key in ("\r", "\n"):
                self.editing = False
            elif key == "ESC":
                self.filter, self.editing = "", False
            elif key in ("\x7f", "\x08"):
                self.filter = self.filter[:-1]
            elif key == "\x15":  # Ctrl-U
                self.filter = ""
            elif len(key) == 1 and key.isprintable():
                self.filter += key
            self.scroll = 0
            return None
        if key in ("q", "Q", "\x03"):
            return "quit"
        if self.help:
            self.help = False
            return None
        if key in self.SORT_KEYS:
            new = self.SORT_KEYS[key]
            self.reverse = not self.reverse if new == self.sort else False
            self.sort, self.scroll = new, 0
        elif key == "r":
            self.reverse = not self.reverse
        elif key == "k":
            self.kthreads = not self.kthreads
        elif key == "/":
            self.editing = True
        elif key == "ESC":
            self.filter = ""
        elif key in ("+", "=", "-", "_"):
            slower = key in ("+", "=")
            steps = [v for v in self.INTERVALS if (v > self.interval if slower else v < self.interval)]
            if steps:
                self.interval = steps[0] if slower else steps[-1]
            return "interval"
        elif key == " ":
            self.paused = not self.paused
        elif key in ("?", "h", "H", "F1"):
            self.help = True
        elif key == "UP":
            self.scroll -= 1
        elif key == "DOWN":
            self.scroll += 1
        elif key == "PGUP":
            self.scroll -= self.page
        elif key == "PGDN":
            self.scroll += self.page
        elif key == "HOME":
            self.scroll = 0
        elif key == "END":
            self.scroll = 1 << 30
        elif key == "\x0c":  # Ctrl-L
            return "redraw"
        self.scroll = max(0, self.scroll)
        return None


def run_live(args):
    mon = Monitor()
    ui = UI(args.interval, args.sort)
    term = Terminal()

    def on_exit_signal(signum, frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, on_exit_signal)
    signal.signal(signal.SIGHUP, on_exit_signal)
    signal.signal(signal.SIGWINCH, lambda *a: None)
    signal.signal(signal.SIGTSTP, lambda *a: None)
    signal.set_wakeup_fd(term.wake_w)

    mon.sample()
    term.enter()
    try:
        mon.fs.snapshot(wait=0.3)
        term.events(0.25)
        mon.sample()
        next_t = time.monotonic() + ui.interval
        dirty = True
        while True:
            if dirty:
                W, H = term.size()
                term.draw(render(mon, ui, W, H))
                dirty = False
            for ev in term.events(max(0.0, next_t - time.monotonic())):
                dirty = True
                if ev == "QUIT":
                    return 0
                if ev == "RESIZE":
                    term.write("\x1b[2J")
                    term.prev = []
                elif ev == "SUSPEND":
                    term.leave()
                    os.kill(os.getpid(), signal.SIGSTOP)
                    term.enter()
                else:
                    res = ui.handle(ev)
                    if res == "quit":
                        return 0
                    if res == "redraw":
                        term.write("\x1b[2J")
                        term.prev = []
                    elif res == "interval":
                        next_t = time.monotonic() + ui.interval
            now = time.monotonic()
            if now >= next_t:
                if not ui.paused:
                    mon.sample()
                dirty = True
                next_t += ui.interval
                if next_t <= now:
                    next_t = now + ui.interval
    except KeyboardInterrupt:
        return 0
    finally:
        term.leave()


def run_once(args):
    mon = Monitor()
    mon.sample()
    mon.fs.snapshot(wait=1.0)
    time.sleep(0.5)
    mon.sample()
    if args.width:
        W = args.width
    elif "COLUMNS" in os.environ or sys.stdout.isatty():
        W = os.get_terminal_size().columns if sys.stdout.isatty() else int(os.environ["COLUMNS"])
    else:
        W = 120
    W = max(40, W)
    ui = UI(sort=args.sort)
    text = "\n".join(render_once(mon, ui, W, args.procs)) + "\n"
    try:
        sys.stdout.buffer.write(text.encode("utf-8", "replace"))
        sys.stdout.flush()
    except BrokenPipeError:
        pass
    return 0


def detect_colors(args, tty):
    if args.color == "never":
        return "none"
    if args.color == "auto" and (not tty or os.environ.get("NO_COLOR")):
        return "none"
    if args.colors:
        return args.colors
    term = os.environ.get("TERM", "")
    if os.environ.get("COLORTERM", "").lower() in ("truecolor", "24bit"):
        return "truecolor"
    if term == "dumb":
        return "none" if args.color == "auto" else "16"
    if term == "linux" or term.startswith(("vt", "ansi", "cons")):
        return "16"
    if "256" in term or term.startswith(("xterm", "screen", "tmux", "rxvt", "alacritty",
                                          "foot", "wezterm", "kitty", "konsole", "gnome")):
        return "256"
    return "16"


def detect_glyphs(args):
    if args.ascii:
        return "ascii"
    if args.unicode:
        return "unicode"
    lang = (os.environ.get("LC_ALL") or os.environ.get("LC_CTYPE") or os.environ.get("LANG") or "").lower()
    if "utf-8" not in lang and "utf8" not in lang:
        return "ascii"
    return "vt" if os.environ.get("TERM") == "linux" else "unicode"


def parse_args(argv=None):
    ap = argparse.ArgumentParser(
        prog="sysmon",
        description="Pretty live system monitor for the Linux console: CPU, memory, "
                    "network, disks and processes in one screen. No dependencies.")
    ap.add_argument("-i", "--interval", type=float, default=1.0, metavar="SEC",
                    help="refresh interval in seconds (default: 1)")
    ap.add_argument("-1", "--once", action="store_true",
                    help="print a single snapshot and exit (also used when stdout is not a terminal)")
    ap.add_argument("-n", "--procs", type=int, default=15, metavar="N",
                    help="process rows in --once mode (default: 15)")
    ap.add_argument("-w", "--width", type=int, metavar="COLS",
                    help="output width for --once (default: terminal width)")
    ap.add_argument("-s", "--sort", choices=sorted(SORTS), default="cpu",
                    help="initial process sort order (default: cpu)")
    ap.add_argument("--color", choices=("auto", "always", "never"), default="auto",
                    help="use colours (default: auto)")
    ap.add_argument("--colors", choices=("16", "256", "truecolor"),
                    help="force the colour depth instead of detecting it")
    glyphs = ap.add_mutually_exclusive_group()
    glyphs.add_argument("--ascii", action="store_true",
                        help="draw with plain ASCII (for fonts without box/block glyphs)")
    glyphs.add_argument("--unicode", action="store_true",
                        help="force Unicode drawing even if the locale is not UTF-8")
    ap.add_argument("-V", "--version", action="version", version="sysmon " + __version__)
    args = ap.parse_args(argv)
    args.interval = min(60.0, max(0.1, args.interval))
    return args


def main(argv=None):
    global G, P
    args = parse_args(argv)
    if not os.path.exists("/proc/stat"):
        sys.stderr.write("sysmon: /proc is not available - this tool needs Linux\n")
        return 1
    live = not args.once and sys.stdout.isatty() and sys.stdin.isatty()
    G = GLYPHS[detect_glyphs(args)]
    P = Palette(detect_colors(args, sys.stdout.isatty()))
    return run_live(args) if live else run_once(args)


if __name__ == "__main__":
    sys.exit(main())
