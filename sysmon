BUILDERS = {"cpu": build_cpu, "mem": build_mem, "net": build_net, "disk": build_disk}


def layout_plans(W):
    """Candidate layouts, most detailed first."""
    if W >= 70:
        lw = W // 2
        top = [("cpu", lw), ("mem", W - lw)]
        full = [top, [("net", lw), ("disk", W - lw)]]
        return [(full, 2), (full, 1), (full, 0), ([top], 1), ([top], 0), ([], 0)]
    rows = [[("cpu", W)], [("mem", W)], [("net", W)], [("disk", W)]]
    return [(rows, 2), (rows, 1), (rows, 0), (rows[:2] + rows[3:], 0),
            (rows[:2], 0), (rows[:1], 0), ([], 0)]


def render_body(mon, ui, W, avail):
    for rows, detail in layout_plans(W):
        built = [[BUILDERS[k](mon, w, detail) for k, w in row] for row in rows]
        heights = [max(p.min_height() for p in row) for row in built]
        proc_min = max(7, avail * 2 // 5) if detail == 2 else 7
        if sum(heights) + proc_min <= avail:
            break
    caps = [max(p.max_height() for p in row) for row in built]
    extra = avail - proc_min - sum(heights)
    while extra > 0:
        grown = False
        for i in range(len(heights)):
            if extra > 0 and heights[i] < caps[i]:
                heights[i] += 1
                extra -= 1
                grown = True
        if not grown:
            break
    out = []
    for row, hgt in zip(built, heights):
        for parts in zip(*[p.render(hgt) for p in row]):
            out.append("".join(parts))
    rest = avail - len(out)
    if rest >= 4:
        out.extend(build_procs(mon, ui, W, rest))
    out.extend([""] * (avail - len(out)))
    return out[:avail]


def render_header(mon, W):
    s = mon.snap
    bg = C_HDR_BG

    def seg(text, fg=C_HDR_FG, bold=False):
        return P.paint(text, fg, bg, bold=bold)

    logo = seg(" " + G["logo"], C_WARN, True) + seg(" sysmon ", C_BRIGHT, True)
    # (drop order: higher goes first, text, colour, bold)
    items = [(0, sanitize(mon.host), C_BRIGHT, True),
             (4, mon.os, C_HDR_FG, False),
             (5, "%s %s" % (mon.kernel, mon.arch), C_HDR_FG, False),
             (1, "up " + fmt_duration(s.uptime), C_HDR_FG, False)]
    if s.users:
        items.append((3, "%d user%s" % (s.users, "" if s.users == 1 else "s"), C_HDR_FG, False))
    if s.battery:
        cap, status = s.battery
        mark = {"Charging": " " + G["up"], "Discharging": " " + G["down"]}.get(status, "")
        items.append((2, "bat %d%%%s" % (cap, mark), grad(1 - cap / 100.0), True))
    clock = seg(time.strftime("%H:%M:%S") + " ", C_BRIGHT, True)
    sep = seg(" " + G["sep"] + " ", C_HDR_SEP)
    while True:
        left = logo + sep + sep.join(seg(t, c, b) for _, t, c, b in items)
        gap = W - vwidth(left) - vwidth(clock)
        if gap >= 1 or len(items) <= 1:
            break
        items.remove(max(items, key=lambda it: it[0]))
    return vfit(left + seg(" " * max(0, gap)) + clock, W)


def render_footer(ui, W):
    acc = ACCENT["proc"]
    if ui.editing:
        line = P.paint(" filter: ", C_LABEL) + P.paint(sanitize(ui.filter), C_BRIGHT, bold=True) + \
            P.paint(G["cursor"], acc) + "   " + P.paint("Enter apply  Esc clear", C_DIM)
        return vfit(line, W)
    keys = [("q", "quit"), (G["up"] + G["down"], "scroll"), ("c m p t n", "sort"),
            ("r", "reverse"), ("/", "filter"), ("k", "kthreads"),
            ("+ -", "%gs" % ui.interval), ("space", "pause"), ("?", "help")]
    if ui.paused:
        status = P.paint(" PAUSED ", C_PAUSE_FG, C_WARN, bold=True)
    else:
        status = P.paint(G["on"], C_GOOD) + " " + P.paint("live %gs" % ui.interval, C_DIM)
    while True:
        left = " " + "  ".join(P.paint(k, acc, bold=True) + " " + P.paint(d, C_DIM)
                               for k, d in keys)
        if vwidth(left) + vwidth(status) + 2 <= W or not keys:
            break
        keys.pop()
    return vfit(left + " " * (W - vwidth(left) - vwidth(status) - 1) + status + " ", W)


HELP = (
    ("q  Ctrl-C", "quit"),
    ("Up Down PgUp PgDn", "scroll the process list"),
    ("Home End", "jump to top / bottom"),
    ("c m p t n", "sort by cpu / mem / pid / time / name"),
    ("", "(press the same key again to flip the order)"),
    ("r", "reverse the sort order"),
    ("/", "filter processes by name or command line"),
    ("Esc", "clear the filter"),
    ("k", "show / hide kernel threads"),
    ("+ -", "slower / faster refresh"),
    ("space", "pause / resume"),
    ("Ctrl-L", "redraw the screen"),
    ("? h F1", "toggle this help"),
)


def overlay_help(lines, W):
    kw = max(len(k) for k, _ in HELP)
    body = [P.paint(k.ljust(kw), ACCENT["proc"], bold=True) + "   " + P.paint(d, C_TEXT)
            for k, d in HELP]
    bw = min(W, kw + 3 + max(len(d) for _, d in HELP) + 4)
    p = Panel(bw, "Keys", ACCENT["proc"], sub="sysmon " + __version__,
              foot=P.paint("any key closes", C_DIM))
    p.add(body)
    box = p.render(min(len(lines), p.min_height()))
    top = max(0, (len(lines) - len(box)) // 2)
    left = max(0, (W - bw) // 2)
    for i, bl in enumerate(box):
        y = top + i
        lines[y] = vslice(lines[y], 0, left) + bl + vslice(lines[y], left + bw, W)


def render(mon, ui, W, H):
    if W < 40 or H < 10:
        lines = [""] * H
        lines[H // 2] = P.paint(fit("terminal too small: %dx%d (need 40x10)" % (W, H), W, "^"), C_WARN)
        return [vfit(l, W) for l in lines]
    lines = [render_header(mon, W)] + render_body(mon, ui, W, H - 2) + [render_footer(ui, W)]
    lines = [vfit(l, W) for l in lines]
    if ui.help:
        overlay_help(lines, W)
    return lines


def render_once(mon, ui, W, nprocs):
    """A full-detail snapshot with natural heights, for --once."""
    lines = [render_header(mon, W)]
    plan = layout_plans(W)[0][0]
    for row in plan:
        built = [BUILDERS[k](mon, w, 2, static=True) for k, w in row]
        hgt = max(p.max_height() for p in built)
        for parts in zip(*[p.render(hgt) for p in built]):
            lines.append("".join(parts))
    if nprocs > 0:
        lines += build_procs(mon, ui, W, nprocs + 3)
    return [vfit(l, W) for l in lines]


