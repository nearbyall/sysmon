def _unescape_mount(s):
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), s)


class FsWatcher(threading.Thread):
    """Collects df-style usage in the background.

    statvfs() on a dead NFS/sshfs mount can block forever, so remote and FUSE
    filesystems are probed in throwaway threads and simply reported as not
    responding instead of freezing the whole UI.
    """

    def __init__(self, period=2.0):
        threading.Thread.__init__(self, name="sysmon-fs")
        self.daemon = True
        self.period = period
        self.lock = threading.Lock()
        self.ready = threading.Event()
        self.result = []
        self.remote = {}  # mount point -> {"busy": bool, "st": statvfs or None}

    def run(self):
        while True:
            try:
                res = self.collect()
            except Exception:  # never let the thread die
                res = []
            with self.lock:
                self.result = res
            self.ready.set()
            time.sleep(self.period)

    def snapshot(self, wait=0.0):
        if wait:
            self.ready.wait(wait)
        with self.lock:
            return self.result

    def _stat_remote(self, mnt):
        ent = self.remote.setdefault(mnt, {"busy": False, "st": None, "since": 0})
        if ent["busy"]:
            return ent["st"], time.monotonic() - ent["since"] > 2 * self.period

        def probe():
            try:
                ent["st"] = os.statvfs(mnt)
            except OSError:
                ent["st"] = None
            ent["busy"] = False

        ent["busy"], ent["since"] = True, time.monotonic()
        t = threading.Thread(target=probe, name="sysmon-statvfs")
        t.daemon = True
        t.start()
        t.join(0.25)
        return ent["st"], ent["busy"]

    def collect(self):
        out, seen = [], set()
        for line in read_text("/proc/self/mounts", "").splitlines():
            f = line.split()
            if len(f) < 3:
                continue
            src, mnt, fstype = _unescape_mount(f[0]), _unescape_mount(f[1]), f[2]
            fuse = fstype.startswith("fuse.")
            if fuse and fstype[5:] in SKIP_FUSE:
                continue
            remote = fstype in REMOTE_FS or fuse
            if not (remote or fstype in LOCAL_FS or (fstype == "overlay" and mnt == "/")):
                continue
            if (mnt + "/").startswith(SKIP_MOUNTS):
                continue
            key = mnt if src in ("none", "overlay", "tmpfs") else src
            if key in seen:  # bind mounts, btrfs subvolumes
                continue
            seen.add(key)
            stale = False
            if remote:
                st, stale = self._stat_remote(mnt)
            else:
                try:
                    st = os.statvfs(mnt)
                except OSError:
                    continue
            item = SimpleNamespace(mount=mnt, dev=src, fstype=fstype, stale=stale,
                                   total=None, used=None, avail=None, pct=None, ipct=None)
            if st is not None:
                total = st.f_blocks * st.f_frsize
                if total <= 0:
                    continue
                used = total - st.f_bfree * st.f_frsize
                avail = st.f_bavail * st.f_frsize
                item.total, item.used, item.avail = total, used, avail
                item.pct = used * 100.0 / (used + avail) if used + avail > 0 else 0.0
                if st.f_files:
                    item.ipct = (st.f_files - st.f_ffree) * 100.0 / st.f_files
            elif not stale:
                continue  # remote fs that refused statvfs (permissions)
            out.append(item)
        out.sort(key=lambda i: (i.mount != "/", i.mount))
        return out


VPN_IFACES = ("tun", "tap", "wg", "ppp", "tailscale", "zt", "nebula", "wwan")


class Proc(object):
    __slots__ = ("pid", "ppid", "state", "comm", "ticks", "prio", "nice", "threads",
                 "start", "vsize", "rss", "kthread", "cpu", "mem", "uid", "user", "cmd")


PF_KTHREAD = 0x00200000


def scan_procs(prev, dt, mem_total):
    """Read /proc/<pid>/stat of every process.

    prev maps pid -> (starttime, cpu ticks) from the previous scan; CPU% is
    the tick delta over the elapsed wall time (100% = one core, like top).
    """
    procs, seen = [], {}
    try:
        names = os.listdir("/proc")
    except OSError:
        return procs, seen
    hz = dt * CLK_TCK if dt else 0.0
    for name in names:
        if not name.isdigit():
            continue
        try:
            with open("/proc/" + name + "/stat", "rb") as fh:
                raw = fh.read()
            lp, rp = raw.index(b"("), raw.rindex(b")")
            f = raw[rp + 2:].split()
            p = Proc()
            p.pid = int(name)
            p.comm = raw[lp + 1:rp].decode("utf-8", "replace")
            p.state = chr(f[0][0])
            p.ppid = int(f[1])
            p.kthread = bool(int(f[6]) & PF_KTHREAD)
            p.ticks = int(f[11]) + int(f[12])
            p.prio, p.nice, p.threads = int(f[15]), int(f[16]), int(f[17])
            p.start, p.vsize = int(f[19]), int(f[20])
            p.rss = int(f[21]) * PAGE_SIZE
        except (OSError, ValueError, IndexError):
            continue
        if hz > 0 and prev is not None:
            old = prev.get(p.pid)
            delta = p.ticks - old[1] if old and old[0] == p.start else p.ticks
            p.cpu = max(0.0, delta * 100.0 / hz)
        else:
            p.cpu = 0.0
        p.mem = p.rss * 100.0 / mem_total if mem_total else 0.0
        p.uid = p.user = p.cmd = None
        seen[p.pid] = (p.start, p.ticks)
        procs.append(p)
    return procs, seen


_user_cache = {}


def proc_user(p):
    if p.user is None:
        try:
            p.uid = os.stat("/proc/%d" % p.pid).st_uid
        except OSError:
            p.user = "?"
            return p.user
        name = _user_cache.get(p.uid)
        if name is None:
            try:
                name = pwd.getpwuid(p.uid).pw_name
            except KeyError:
                name = str(p.uid)
            _user_cache[p.uid] = name
        p.user = name
    return p.user


def proc_cmd(p):
    if p.cmd is None:
        try:
            with open("/proc/%d/cmdline" % p.pid, "rb") as fh:
                raw = fh.read(4096)
        except OSError:
            raw = b""
        args = [a.decode("utf-8", "replace") for a in raw.split(b"\0")]
        while args and not args[-1]:
            args.pop()
        p.cmd = args
    return p.cmd


class Monitor(object):
    """Samples the whole system and keeps short histories for the graphs."""

    HIST = 1000

    def __init__(self):
        u = os.uname()
        self.host = socket.gethostname() or u.nodename
        self.kernel = u.release
        self.arch = u.machine
        self.os = os_name()
        self.model = cpu_model()
        self.sensors = Sensors()
        self.fs = FsWatcher()
        self.fs.start()
        hist = lambda: collections.deque(maxlen=self.HIST)  # noqa: E731
        self.h_cpu, self.h_mem, self.h_rx, self.h_tx = hist(), hist(), hist(), hist()
        self.t = None
        self._cpu = None
        self._ctxt = None
        self._net = None
        self._io = None
        self._procs = None
        self._ifcache = {}
        self._if_active = {}
        self._blk = block_devices()
        self._slow_at = 0.0
        self.users = None
        self.battery = None
        self.snap = None

    def _iface(self, name, now):
        ent = self._ifcache.get(name)
        if ent is None or now - ent[0] > 3:
            base = "/sys/class/net/" + name
            info = dict(physical=os.path.exists(base + "/device"),
                        state=(read_text(base + "/operstate") or "?").strip(),
                        speed=read_int(base + "/speed"),
                        ip=ipv4_addr(name))
            ent = self._ifcache[name] = (now, info)
        return ent[1]

    def sample(self):
        now = time.monotonic()
        dt = now - self.t if self.t is not None else None
        self.t = now
        s = SimpleNamespace(dt=dt)

        if now >= self._slow_at:
            self._slow_at = now + 5
            self.users = logged_in_users()
            self.battery = read_battery()
            self._blk = block_devices()
        s.users, s.battery = self.users, self.battery

        # CPU
        cpus, ctxt = read_proc_stat()
        prev = self._cpu or {}
        idle = dict(busy=0.0, usr=0.0, sys=0.0, wait=0.0, irq=0.0, steal=0.0)
        s.cpu = cpu_usage(prev.get("cpu"), cpus.get("cpu")) or idle
        names = sorted((k for k in cpus if k != "cpu"), key=lambda k: int(k[3:]))
        s.cores = []
        for k in names:
            u = cpu_usage(prev.get(k), cpus[k])
            s.cores.append(u["busy"] if u else (0.0 if not prev else None))
        s.ncpu = len(names) or os.cpu_count() or 1
        s.ctxt = (ctxt - self._ctxt) / dt if dt and self._ctxt is not None else None
        self._cpu, self._ctxt = cpus, ctxt
        s.freq = read_freq()
        s.temp, s.temps = self.sensors.read()
        load = (read_text("/proc/loadavg") or "0 0 0").split()
        s.load = tuple(float(x) for x in load[:3])
        s.uptime = float((read_text("/proc/uptime") or "0").split()[0])
        if dt:
            self.h_cpu.append(s.cpu["busy"])

        # Memory
        m = read_meminfo()
        total = m.get("MemTotal", 0)
        free = m.get("MemFree", 0)
        buffers = m.get("Buffers", 0)
        cache = m.get("Cached", 0) + m.get("SReclaimable", 0)
        used = total - free - buffers - cache
        if used < 0:
            used = total - free
        s.mem = SimpleNamespace(
            total=total, used=used, free=free, cache=buffers + cache,
            avail=m.get("MemAvailable", free + buffers + cache),
            shared=m.get("Shmem", 0), dirty=m.get("Dirty", 0),
            swap_total=m.get("SwapTotal", 0),
            swap_used=m.get("SwapTotal", 0) - m.get("SwapFree", 0))
        if dt and total:
            self.h_mem.append(used * 100.0 / total)
        s.psi = read_psi()

        # Network
        net = read_net_dev()
        ifaces = []
        for name, (rx, tx) in net.items():
            if name == "lo" or name.startswith("veth"):
                continue
            info = self._iface(name, now)
            old = self._net.get(name) if self._net else None
            rrx = rtx = None
            if dt and old:
                rrx, rtx = max(0, rx - old[0]) / dt, max(0, tx - old[1]) / dt
            ifaces.append(SimpleNamespace(name=name, rx=rx, tx=tx, rrx=rrx, rtx=rtx, **info))
        self._net = net
        # Count only real NICs in the totals: bridges/tunnels would double count.
        agg = [i for i in ifaces if i.physical] or ifaces
        s.rx_rate = sum(i.rrx or 0 for i in agg)
        s.tx_rate = sum(i.rtx or 0 for i in agg)
        s.rx_total = sum(i.rx for i in agg)
        s.tx_total = sum(i.tx for i in agg)
        if dt:
            self.h_rx.append(s.rx_rate)
            self.h_tx.append(s.tx_rate)
        # Show real NICs and VPNs; bridges and other virtual links only while
        # they carry traffic (a Docker host has dozens of idle br-* links).
        for i in ifaces:
            if (i.rrx or 0) + (i.rtx or 0) > 0:
                self._if_active[i.name] = now
        shown = [i for i in ifaces if i.physical
                 or (i.name.startswith(VPN_IFACES) and i.state in ("up", "unknown"))
                 or now - self._if_active.get(i.name, -1e9) < 60]
        if not shown:  # e.g. inside a container, where eth0 is virtual too
            shown = [i for i in ifaces if i.state in ("up", "unknown")]
        shown.sort(key=lambda i: (not i.physical, i.state != "up", -(i.rx + i.tx)))
        s.ifaces = shown

        # Disk I/O and usage
        cur = read_diskstats(set(self._blk))
        s.io = []
        for name in self._blk:
            c = cur.get(name)
            if c is None:
                continue
            old = self._io.get(name) if self._io else None
            r = w = util = None
            if dt and old:
                r, w = max(0, c[0] - old[0]) / dt, max(0, c[1] - old[1]) / dt
                util = min(100.0, max(0, c[2] - old[2]) / (dt * 10.0))
            s.io.append(SimpleNamespace(name=name, r=r, w=w, util=util))
        self._io = cur
        s.io_r = sum(d.r or 0 for d in s.io)
        s.io_w = sum(d.w or 0 for d in s.io)
        s.fs = self.fs.snapshot()

        # Processes
        s.procs, self._procs = scan_procs(self._procs, dt, total)
        states = collections.Counter(p.state for p in s.procs)
        s.tasks = len(s.procs)
        s.running = states.get("R", 0)
        s.blocked = states.get("D", 0)
        s.zombie = states.get("Z", 0)
        s.threads = sum(p.threads for p in s.procs)
        self.snap = s


