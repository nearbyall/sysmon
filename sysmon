def build_cpu(mon, w, detail, static=False):
    s = mon.snap
    iw = w - 4
    right = []
    if s.freq:
        right.append(P.paint("%.2f GHz" % (s.freq / 1000.0), C_TEXT))
    if s.temp is not None:
        right.append(P.paint("%d%sC" % (round(s.temp), G["deg"]),
                             grad((s.temp - 40) / 50.0), bold=True))
    load = " ".join(P.paint("%.2f" % l, grad(l / s.ncpu)) for l in s.load)
    p = Panel(w, "CPU", ACCENT["cpu"], sub=mon.model, right=sep_join(right),
              foot=P.paint("load", C_DIM) + " " + load,
              foot_right=P.paint("%d cores" % s.ncpu, C_DIM))

    busy = s.cpu["busy"]
    p.add([bar(iw - 7, [(busy / 100.0, None)]) + " " +
           P.paint("%5.1f%%" % busy, grad(busy / 100.0), bold=True)])
    if detail >= 1:
        items = [("usr", s.cpu["usr"]), ("sys", s.cpu["sys"]), ("wait", s.cpu["wait"]),
                 ("irq", s.cpu["irq"]), ("steal", s.cpu["steal"])]
        line, width = "", 0
        for k, v in items:
            cell = P.paint(k, C_DIM) + " " + P.paint("%.1f%%" % v, C_TEXT if v < 10 else grad(v / 100.0))
            cw = vwidth(cell) + 2
            if width + cw > iw + 2:
                break
            line += cell + "  "
            width += cw
        p.add([line])
    if not static:
        p.flex(lambda n: graph(mon.h_cpu, iw, n), hi=10)

    # Per-core meters: as many columns as needed to stay within the row cap,
    # or a one-cell-per-core strip on big machines.
    n = len(s.cores)
    lw = len(str(max(0, n - 1)))
    rows_cap = 99 if static else {2: 4, 1: 2, 0: 1}[detail]
    gap = 2
    best = None
    for cols in range(1, n + 1):
        ew = (iw - gap * (cols - 1)) // cols
        bw = ew - lw - 6
        if bw < 4:
            break
        best = (cols, ew, bw)
        if -(-n // cols) <= rows_cap:
            break
    lines = []
    if best and -(-n // best[0]) <= max(rows_cap, 4 if static else rows_cap):
        cols, ew, bw = best
        rows = -(-n // cols)
        for r in range(rows):
            cells = []
            for c in range(cols):
                i = c * rows + r
                if i >= n:
                    break
                u = s.cores[i]
                lab = P.paint(str(i).rjust(lw), C_DIM)
                if u is None:
                    cells.append(lab + " " + P.paint(fit("offline", bw + 5), C_DIM))
                else:
                    cells.append(lab + " " + bar(bw, [(u / 100.0, None)]) + " " +
                                 P.paint("%3.0f%%" % u, grad(u / 100.0)))
            lines.append((" " * gap).join(cells))
    elif n:
        vb = G["vb"]
        cells = []
        for u in s.cores:
            if u is None:
                cells.append(P.paint(G["dot"], C_DIM))
            else:
                k = max(1, int(u / 100.0 * (len(vb) - 1) + 0.5))
                cells.append(P.paint(vb[k], grad(u / 100.0)))
        for i in range(0, n, iw):
            lines.append("".join(cells[i:i + iw]))
    p.add(lines)

    if detail >= 2 and s.temps:
        parts = [P.paint(name, C_DIM) + " " +
                 P.paint("%d%sC" % (round(t), G["deg"]), grad((t - 40) / 50.0))
                 for name, t in s.temps]
        p.add([P.paint("temp", C_LABEL) + "  " + "  ".join(parts)])
    return p


def build_mem(mon, w, detail, static=False):
    s = mon.snap
    m = s.mem
    iw = w - 4
    p = Panel(w, "Memory", ACCENT["mem"], sub=fmt_bytes(m.total),
              right=P.paint("avail ", C_DIM) + P.paint(fmt_bytes(m.avail), C_GOOD, bold=True))
    aw = 11 if iw >= 40 else 0
    bw = iw - 12 - (aw + 1 if aw else 0)

    def meter(name, used, total, extra=None):
        pct = used * 100.0 / total if total else 0.0
        segs = [(used / float(total), None)]
        if extra:
            segs.append((extra / float(total), C_CACHE))
        line = P.paint(fit(name, 4), C_LABEL) + " " + bar(bw, segs) + " " + \
            P.paint("%5.1f%%" % pct, grad(pct / 100.0), bold=True)
        if aw:
            line += " " + P.paint(fit(fmt_bytes(used) + "/" + fmt_bytes(total), aw, ">"), C_TEXT)
        return line

    lines = [meter("RAM", m.used, m.total or 1, m.cache)]
    if m.swap_total:
        lines.append(meter("Swap", m.swap_used, m.swap_total))
    else:
        lines.append(P.paint(fit("Swap", 4), C_LABEL) + " " + P.paint("not configured", C_DIM))
    p.add(lines)

    if detail >= 1:
        items = [("avail", m.avail, C_GOOD), ("used", m.used, C_TEXT),
                 ("cache", m.cache, C_CACHE), ("free", m.free, C_TEXT),
                 ("shared", m.shared, C_TEXT), ("dirty", m.dirty, C_TEXT)]
        cw = 15
        cols = max(1, (iw + 2) // cw)
        if detail < 2:
            items = items[:cols]
        grid = []
        for i in range(0, len(items), cols):
            cells = [P.paint(fit(k, 6), C_DIM) + P.paint(fmt_bytes(v).rjust(6), c)
                     for k, v, c in items[i:i + cols]]
            grid.append("   ".join(cells))
        p.add(grid)
    if detail >= 2 and s.psi:
        parts = [P.paint(k, C_DIM) + " " + P.paint("%.1f%%" % s.psi[r], grad(s.psi[r] / 40.0))
                 for r, k in (("cpu", "cpu"), ("memory", "mem"), ("io", "io")) if r in s.psi]
        p.add([P.paint("pressure", C_LABEL) + "  " + "  ".join(parts)])
    if not static:
        p.flex(lambda n: graph(mon.h_mem, iw, n, MEM_GRAD), hi=10)
    return p


def build_net(mon, w, detail, static=False):
    s = mon.snap
    iw = w - 4
    p = Panel(w, "Network", ACCENT["net"],
              right=P.paint("%s %s  %s %s" % (G["down"], fmt_bytes(s.rx_total),
                                               G["up"], fmt_bytes(s.tx_total)), C_DIM))
    floor = 10 * 1024.0  # keep an idle link looking idle
    peak_rx = max(list(mon.h_rx)[-iw:] or [0])
    peak_tx = max(list(mon.h_tx)[-iw:] or [0])

    def rate_line(arrow, name, rate, peak, color):
        line = P.paint(arrow + " " + name, color, bold=True) + "  " + \
            P.paint(fmt_rate(rate).rjust(8), C_BRIGHT, bold=True)
        if not static:
            line += "   " + P.paint("peak " + fmt_rate(peak), C_DIM)
        return line

    def mirrored(n):
        up = (n + 1) // 2
        out = graph(mon.h_rx, iw, up, RX_GRAD, max(peak_rx, floor))
        if n - up:
            out += graph(mon.h_tx, iw, n - up, TX_GRAD, max(peak_tx, floor), down=True)
        return out

    p.add([rate_line(G["down"], "RX", s.rx_rate, peak_rx, C_RX)])
    if not static:
        p.flex(mirrored, hi=8, prio=2)
    p.add([rate_line(G["up"], "TX", s.tx_rate, peak_tx, C_TX)])

    show_ip = iw >= 50
    nw = max(4, min(16, iw - (40 if show_ip else 24)))

    def iface_line(i):
        up = i.state in ("up", "unknown")
        left = P.paint(G["on"] if up else G["off"], C_GOOD if up else C_BAD) + " " + \
            P.paint(fit(sanitize(i.name), nw), C_TEXT, bold=True)
        if show_ip:
            left += " " + P.paint(fit(i.ip or "", 15), C_LABEL)
        right = P.paint(G["down"], C_RX) + P.paint(fmt_rate(i.rrx).rjust(8), C_TEXT) + "  " + \
            P.paint(G["up"], C_TX) + P.paint(fmt_rate(i.rtx).rjust(8), C_TEXT)
        return left + " " * max(1, iw - vwidth(left) - vwidth(right)) + right

    lines = [iface_line(i) for i in s.ifaces]
    cap = len(lines) if static else min(len(lines), {2: 3, 1: 1, 0: 0}[detail])
    p.flex(lambda n: lines[:n], lo=cap, hi=len(lines), prio=0)
    return p


def build_disk(mon, w, detail, static=False):
    s = mon.snap
    iw = w - 4
    p = Panel(w, "Disks", ACCENT["disk"],
              right=P.paint("R ", C_DIM) + P.paint(fmt_rate(s.io_r), C_TEXT) + "  " +
              P.paint("W ", C_DIM) + P.paint(fmt_rate(s.io_w), C_TEXT))
    mw = max(6, min(16, iw // 4))
    tw = 6 if iw >= 64 else 0
    aw = 11 if iw >= 44 else 0
    bw = iw - mw - 1 - (tw + 1 if tw else 0) - 5 - (aw + 1 if aw else 0)

    fs_lines = []
    for f in s.fs:
        line = P.paint(fit(clip_left(sanitize(f.mount), mw), mw), C_TEXT, bold=True) + " "
        if tw:
            line += P.paint(fit(f.fstype.replace("fuse.", ""), tw), C_DIM) + " "
        if f.pct is None or f.stale:
            line += P.paint("not responding" if f.stale else "...", C_WARN)
        else:
            line += bar(bw, [(f.pct / 100.0, None)]) + " " + \
                P.paint("%3.0f%%" % f.pct, grad(f.pct / 100.0), bold=True)
            if aw:
                line += " " + P.paint(fit(fmt_bytes(f.used) + "/" + fmt_bytes(f.total), aw, ">"), C_TEXT)
        fs_lines.append(line)

    io_lines = []
    ubw = iw - mw - 1 - 22 - 2 - 5
    for d in s.io:
        line = P.paint(fit(d.name, mw), ACCENT["disk"]) + " " + \
            P.paint("R", C_DIM) + P.paint(fmt_rate(d.r).rjust(9), C_TEXT) + "  " + \
            P.paint("W", C_DIM) + P.paint(fmt_rate(d.w).rjust(9), C_TEXT)
        if ubw >= 4 and d.util is not None:
            line += "  " + bar(ubw, [(d.util / 100.0, None)]) + " " + \
                P.paint("%3.0f%%" % d.util, grad(d.util / 100.0))
        io_lines.append(line)

    def content(n):
        if n >= len(fs_lines) + len(io_lines):
            return fs_lines + io_lines
        io_n = min(len(io_lines), max(1, n // 3)) if io_lines else 0
        fs_n = min(len(fs_lines), n - io_n)
        io_n = min(len(io_lines), n - fs_n)
        return fs_lines[:fs_n] + io_lines[:io_n]

    total = len(fs_lines) + len(io_lines)
    cap = total if static else min(total, {2: 6, 1: 3, 0: 1}[detail])
    p.flex(content, lo=cap, hi=total, prio=0)
    return p


SORTS = {
    "cpu": (lambda p: (p.cpu, p.ticks), True),
    "mem": (lambda p: p.rss, True),
    "pid": (lambda p: p.pid, False),
    "time": (lambda p: p.ticks, True),
    "name": (lambda p: p.comm.lower(), False),
}

# key, title, width, align, minimal inner width to show the column
PROC_COLS = (
    ("pid", "PID", 7, ">", 0),
    ("user", "USER", 9, "<", 60),
    ("pri", "PR", 3, ">", 100),
    ("ni", "NI", 3, ">", 100),
    ("state", "S", 1, "<", 60),
    ("cpu", "CPU%", 5, ">", 0),
    ("mem", "MEM%", 5, ">", 0),
    ("virt", "VIRT", 5, ">", 100),
    ("res", "RES", 5, ">", 44),
    ("thr", "THR", 4, ">", 110),
    ("time", "TIME+", 8, ">", 76),
)
STATE_COLORS = {"R": C_GOOD, "D": C_WARN, "Z": C_BAD, "T": C_TX, "t": C_TX}


def visible_procs(mon, ui):
    procs = mon.snap.procs
    if not ui.kthreads:
        procs = [p for p in procs if not p.kthread]
    if ui.filter:
        needle = ui.filter.lower()
        procs = [p for p in procs
                 if needle in p.comm.lower() or needle in " ".join(proc_cmd(p)).lower()]
    key, desc = SORTS[ui.sort]
    return sorted(procs, key=key, reverse=desc != ui.reverse)


def build_procs(mon, ui, w, h):
    s = mon.snap
    iw = w - 4
    acc = ACCENT["proc"]
    procs = visible_procs(mon, ui)
    rows = max(0, h - 3)
    ui.page = max(1, rows)
    ui.scroll = max(0, min(ui.scroll, len(procs) - rows))
    shown = procs[ui.scroll:ui.scroll + rows]

    cols = [c for c in PROC_COLS if iw >= c[4]]
    cmd_w = iw - sum(c[2] + 1 for c in cols)
    arrow = G["desc"] if SORTS[ui.sort][1] != ui.reverse else G["asc"]
    sort_col = {"cpu": "cpu", "mem": "mem", "pid": "pid", "time": "time"}.get(ui.sort, "cmd")

    hdr = []
    for key, title, width, align, _ in cols:
        if key == sort_col:
            hdr.append(P.paint(fit(title + arrow, width, align), C_BRIGHT, C_TBL_BG, bold=True))
        else:
            hdr.append(P.paint(fit(title, width, align), C_LABEL, C_TBL_BG, bold=True))
    title = "COMMAND" + (arrow if sort_col == "cmd" else "")
    hdr.append(P.paint(fit(title, cmd_w), C_BRIGHT if sort_col == "cmd" else C_LABEL,
                       C_TBL_BG, bold=True))
    lines = [P.paint(" ", bg=C_TBL_BG).join(hdr)]

    for pr in shown:
        cells = []
        for key, _, width, align, _ in cols:
            if key == "pid":
                cells.append(P.paint(str(pr.pid).rjust(width), C_DIM))
            elif key == "user":
                name = proc_user(pr)
                color = C_BAD if pr.uid == 0 else (C_GOOD if pr.uid == MY_UID else C_TEXT)
                cells.append(P.paint(fit(sanitize(name), width), color))
            elif key == "pri":
                cells.append(P.paint(("rt" if pr.prio <= -100 else str(pr.prio)).rjust(width), C_DIM))
            elif key == "ni":
                color = C_BAD if pr.nice < 0 else (C_CACHE if pr.nice > 0 else C_DIM)
                cells.append(P.paint(str(pr.nice).rjust(width), color))
            elif key == "state":
                cells.append(P.paint(pr.state, STATE_COLORS.get(pr.state, C_DIM), bold=pr.state == "R"))
            elif key == "cpu":
                txt = ("%5.1f" if pr.cpu < 999.95 else "%5.0f") % pr.cpu
                cells.append(P.paint(txt, grad(pr.cpu / 100.0) if pr.cpu >= 0.05 else C_DIM))
            elif key == "mem":
                cells.append(P.paint("%5.1f" % pr.mem, grad(pr.mem / 50.0) if pr.mem >= 0.05 else C_DIM))
            elif key == "virt":
                cells.append(P.paint(fmt_bytes(pr.vsize).rjust(width), C_DIM))
            elif key == "res":
                cells.append(P.paint(fmt_bytes(pr.rss).rjust(width), C_TEXT))
            elif key == "thr":
                cells.append(P.paint(str(pr.threads).rjust(width), C_DIM))
            elif key == "time":
                cells.append(P.paint(fmt_cputime(pr.ticks).rjust(width), C_LABEL))
        args = [] if pr.kthread else proc_cmd(pr)
        if pr.state == "Z":
            cmd = P.paint(clip(sanitize("[%s] <defunct>" % pr.comm), cmd_w), C_BAD)
        elif not args:
            cmd = P.paint(clip(sanitize("[%s]" % pr.comm), cmd_w), C_DIM)
        else:
            exe = sanitize(args[0])
            base = exe if " " in exe else (os.path.basename(exe) or exe)
            base = clip(base, cmd_w)
            cmd = P.paint(base, C_BRIGHT, bold=True)
            room = cmd_w - text_width(base) - 1
            if len(args) > 1 and room > 0:
                cmd += " " + P.paint(clip(sanitize(" ".join(args[1:])), room), C_LABEL)
        cells.append(cmd)
        lines.append(" ".join(cells))

    right = [P.paint("%d tasks" % s.tasks, C_TEXT)]
    if s.running:
        right.append(P.paint("%d running" % s.running, C_GOOD))
    if s.blocked:
        right.append(P.paint("%d blocked" % s.blocked, C_WARN))
    if s.zombie:
        right.append(P.paint("%d zombie" % s.zombie, C_BAD))
    right.append(P.paint("%d threads" % s.threads, C_DIM))
    foot = [P.paint("sort ", C_DIM) + P.paint(ui.sort + " " + arrow, acc)]
    if ui.kthreads:
        foot.append(P.paint("+kernel threads", C_DIM))
    if ui.filter:
        foot.append(P.paint("filter ", C_DIM) + P.paint('"%s"' % sanitize(ui.filter), C_WARN, bold=True))
    pos = ""
    if procs:
        pos = P.paint("%d-%d of %d" % (ui.scroll + 1, ui.scroll + len(shown), len(procs)), C_DIM)
    elif ui.filter:
        pos = P.paint("no matches", C_WARN)
    p = Panel(w, "Processes", acc, right=sep_join(right), foot=sep_join(foot), foot_right=pos)
    p.add(lines)
    return p.render(h)


